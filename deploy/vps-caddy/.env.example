# Copie para .env e edite. docker compose up -d
DOMAIN=llm.seudominio.com

POSTGRES_USER=llmproxy
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=llmproxy

# 64+ caracteres aleatórios. Vazio = o app gera e persiste em /data.
# Gere com: openssl rand -base64 48
SESSION_SECRET=

# Admin automático (opcional). Sem isso, cria no 1º acesso pela tela de setup.
# ADMIN_EMAIL=voce@seudominio.com
# ADMIN_PASSWORD=troque-esta-senha
