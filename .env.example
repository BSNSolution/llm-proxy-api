# =====================================================================
# LLM Proxy API — exemplo de configuração
# Copie para .env e ajuste. TODAS as variáveis têm default sensato para
# rodar local; para Docker/produção veja docker-compose.yml e o README.
# =====================================================================

# ── App ──────────────────────────────────────────────
NODE_ENV=development
# Porta do backend (serve o proxy /v1 + a API /api + o painel web)
API_PORT=8787
# URL pública do app (usada no preview da URL das keys). Em produção, o
# domínio/host onde o app é acessível (ex.: https://llmproxy.seudominio.com).
PUBLIC_BASE_URL=http://localhost:8787
# Bind. Default loopback (só a própria máquina). Em Docker use 0.0.0.0.
# ⚠️ NUNCA exponha o proxy cru na internet pública — ele dá acesso às suas
#    assinaturas de LLM. Use tailnet (Tailscale) ou HTTPS + firewall.
API_HOST=127.0.0.1

# ── Banco (Postgres) ─────────────────────────────────
DATABASE_URL=postgresql://llmproxy:llmproxy@localhost:5437/llmproxy?schema=public

# ── Redis (rate-limit / quota) ───────────────────────
REDIS_URL=redis://localhost:6380

# ── Segurança ────────────────────────────────────────
# Segredo p/ assinar as sessões. Se você NÃO definir, o app gera um forte
# automaticamente e persiste em DATA_DIR/.session-secret (recomendado).
# Defina manualmente só se quiser controlar/rotacionar você mesmo.
# SESSION_SECRET=
# Allowlist de env vars repassadas ao spawn das CLIs (CSV). Hardening.
CLI_ENV_ALLOWLIST=HOME,PATH,USER,USERPROFILE,APPDATA,LOCALAPPDATA,SHELL,LANG,TERM

# ── Admin inicial (opcional) ─────────────────────────
# Por padrão, o admin é criado no PRIMEIRO ACESSO pela tela de setup do app.
# Se preferir criar automaticamente (deploy sem interação), defina os dois:
# ADMIN_EMAIL=voce@exemplo.com
# ADMIN_PASSWORD=troque-esta-senha

# ── Dados persistentes ───────────────────────────────
# Onde ficam dados que precisam sobreviver a restart (session secret, etc.).
# Vazio = <raiz>/.data (local). No Docker, aponte para um VOLUME.
# DATA_DIR=/data

# ── Imagens geradas ──────────────────────────────────
# Onde as imagens geradas são salvas. No Docker, aponte para um VOLUME
# (ex.: /data/images) para que sobrevivam a rebuilds.
# IMAGES_DIR=/data/images

# ── Áudio (opcional) ─────────────────────────────────
# Transcrição de áudio nos anexos usa whisper.cpp (whisper-cli) + modelo ggml.
# WHISPER_MODEL_PATH=/caminho/para/ggml-base.bin

# ── Web (build) ──────────────────────────────────────
VITE_API_URL=http://localhost:8787
