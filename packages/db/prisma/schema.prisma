// llm-proxy-api — schema Prisma
// Single-machine: sem Node remoto. As CLIs rodam na própria máquina.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Admin(s) da aplicação — quem administra o proxy pela UI.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String? // nome de exibição (opcional)
  passwordHash String
  role         UserRole @default(admin)
  disabled     Boolean  @default(false) // desativado: não loga, mas mantém histórico
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     Session[]
  proxyKeys    ProxyKey[]
  chatSessions ChatSession[]
  auditLogs    AuditLog[]
}

enum UserRole {
  admin
  viewer
}

/// Sessão da UI (estado no DB — cross-device, nunca em localStorage).
model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  userAgent  String? // p/ a tela de sessões (identificar o dispositivo)
  ip         String?
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Cache do resultado da detecção de uma CLI na máquina.
model DetectedCli {
  id           String   @id @default(cuid())
  kind         CliKind  @unique
  present      Boolean  @default(false)
  binaryPath   String?
  version      String?
  capabilities Json // CliCapabilities serializado
  models       String[] @default([])
  defaultModel String?
  lastProbedAt DateTime @default(now())
}

/// Configuração de uma CLI escolhida para ser exposta.
model CliConfig {
  id              String   @id @default(cuid())
  kind            CliKind  @unique
  enabled         Boolean  @default(false)
  defaultModel    String?
  allowedModels   String[] @default([])
  thinkingDefault Boolean  @default(false)
  timeoutMs       Int      @default(120000)
  extra           Json? // config específica por CLI
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// API key do Proxy (formato sk-llmp-…).
model ProxyKey {
  id              String    @id @default(cuid())
  ownerId         String
  name            String
  cliKind         CliKind
  defaultModel    String?
  allowedModels   String[]  @default([])
  corsOrigins     String[]  @default([])
  keyHash         String    @unique
  prefix          String
  rateLimitPerMin Int       @default(20)
  dailyTokenQuota Int? // null = sem limite
  maxInputChars   Int       @default(24000)
  timeoutMs       Int       @default(120000)
  enabled         Boolean   @default(true)
  tokenSaver      Boolean   @default(true) // comprime tool_result (RTK-like); header pode sobrescrever
  terseness       String    @default("off") // off | caveman | ponytail (+ :level opcional)
  expiresAt       DateTime?
  revokedAt       DateTime?
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  usageLogs UsageLog[]

  @@index([prefix])
  @@index([ownerId])
}

/// Sessão de chat interativo pela UI.
model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  cliKind   CliKind
  model     String?
  title     String        @default("Nova conversa")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id           String      @id @default(cuid())
  sessionId    String
  role         String // system|user|assistant|tool
  content      String
  attachments  Json? // Attachment[]
  toolCalls    Json?
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime    @default(now())
  session      ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

/// Log de uso por request no proxy (para métricas/limites).
model UsageLog {
  id           String   @id @default(cuid())
  proxyKeyId   String
  ts           DateTime @default(now())
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  estimated    Boolean  @default(true)
  latencyMs    Int      @default(0)
  status       Int      @default(200)
  proxyKey     ProxyKey @relation(fields: [proxyKeyId], references: [id], onDelete: Cascade)

  @@index([proxyKeyId, ts])
}

model AuditLog {
  id      String   @id @default(cuid())
  actorId String?
  action  String
  target  String?
  meta    Json?
  ts      DateTime @default(now())
  actor   User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ts])
}

enum CliKind {
  claude
  codex
  gemini
  cursor
  opencode
  antigravity
  // 2º lote — outras CLIs do mercado
  copilot
  aider
  qwen
  amp
  goose
  grok
  continue
}

/// Fonte de execução de um item: CLI local (subscription) ou HTTP (API key).
enum SourceKind {
  cli
  http
}

/// Provider HTTP suportado (espelha as CLIs que já operamos — não é catálogo).
enum HttpProvider {
  anthropic
  openai
  gemini
}

/// Credencial HTTP por provider (API key cifrada) — habilita deploy em
/// container/VPS/CF onde não há CLI local, e itens HTTP em combos.
model HttpProviderConfig {
  id           String       @id @default(cuid())
  provider     HttpProvider @unique
  apiKeyCipher String // encryptSecret(apiKey) — nunca em texto puro
  baseUrl      String? // override do endpoint (proxy corporativo)
  enabled      Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

/// Combo = lista ordenada de fontes/modelos com fallback automático.
/// Vira "modelo virtual" no proxy: model="combo:<slug>".
model Combo {
  id        String      @id @default(cuid())
  ownerId   String
  slug      String // identificador usado no proxy (único por dono)
  name      String
  strategy  String      @default("priority") // priority | round-robin
  enabled   Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     ComboItem[]

  @@unique([ownerId, slug])
  @@index([ownerId])
}

model ComboItem {
  id       String       @id @default(cuid())
  comboId  String
  order    Int // posição no fallback (0 = primário)
  source   SourceKind   @default(cli)
  cliKind  CliKind? // quando source=cli
  provider HttpProvider? // quando source=http
  model    String?
  combo    Combo        @relation(fields: [comboId], references: [id], onDelete: Cascade)

  @@index([comboId, order])
}

/// Router (workflow) = mapa capacidade→destino. O proxy detecta a capacidade do
/// request (ou recebe override cap:<slug>) e despacha p/ a LLM especialista.
/// model="router" (default) ou model="router:<slug>".
model Router {
  id        String       @id @default(cuid())
  ownerId   String
  slug      String
  name      String
  isDefault Boolean      @default(false)
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  rules     RouterRule[]

  @@unique([ownerId, slug])
  @@index([ownerId])
}

model RouterRule {
  id         String        @id @default(cuid())
  routerId   String
  capability String // FunctionCapability slug (ex.: analisar-imagem)
  // destino: uma fonte direta OU um combo
  source     SourceKind?   @default(cli)
  cliKind    CliKind?
  provider   HttpProvider?
  model      String?
  comboId    String? // se setado, despacha p/ o combo (com fallback)
  router     Router        @relation(fields: [routerId], references: [id], onDelete: Cascade)

  @@unique([routerId, capability])
  @@index([routerId])
}
