// llm-proxy-api — schema Prisma
// Single-machine: sem Node remoto. As CLIs rodam na própria máquina.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Admin(s) da aplicação — quem administra o proxy pela UI.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String? // nome de exibição (opcional)
  passwordHash String
  role         UserRole @default(admin)
  disabled     Boolean  @default(false) // desativado: não loga, mas mantém histórico
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     Session[]
  proxyKeys    ProxyKey[]
  chatSessions ChatSession[]
  auditLogs    AuditLog[]
}

enum UserRole {
  admin
  viewer
}

/// Sessão da UI (estado no DB — cross-device, nunca em localStorage).
model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  userAgent  String? // p/ a tela de sessões (identificar o dispositivo)
  ip         String?
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Cache do resultado da detecção de uma CLI na máquina.
model DetectedCli {
  id           String   @id @default(cuid())
  kind         CliKind  @unique
  present      Boolean  @default(false)
  binaryPath   String?
  version      String?
  capabilities Json // CliCapabilities serializado
  models       String[] @default([])
  defaultModel String?
  lastProbedAt DateTime @default(now())
}

/// Configuração de uma CLI escolhida para ser exposta.
model CliConfig {
  id              String   @id @default(cuid())
  kind            CliKind  @unique
  enabled         Boolean  @default(false)
  defaultModel    String?
  allowedModels   String[] @default([])
  thinkingDefault Boolean  @default(false)
  timeoutMs       Int      @default(120000)
  extra           Json? // config específica por CLI
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// API key do Proxy (formato sk-llmp-…).
model ProxyKey {
  id              String    @id @default(cuid())
  ownerId         String
  name            String
  cliKind         CliKind
  defaultModel    String?
  allowedModels   String[]  @default([])
  corsOrigins     String[]  @default([])
  keyHash         String    @unique
  prefix          String
  rateLimitPerMin Int       @default(20)
  dailyTokenQuota Int? // null = sem limite
  maxInputChars   Int       @default(24000)
  timeoutMs       Int       @default(120000)
  enabled         Boolean   @default(true)
  expiresAt       DateTime?
  revokedAt       DateTime?
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  usageLogs UsageLog[]

  @@index([prefix])
  @@index([ownerId])
}

/// Sessão de chat interativo pela UI.
model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  cliKind   CliKind
  model     String?
  title     String        @default("Nova conversa")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id           String      @id @default(cuid())
  sessionId    String
  role         String // system|user|assistant|tool
  content      String
  attachments  Json? // Attachment[]
  toolCalls    Json?
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime    @default(now())
  session      ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

/// Log de uso por request no proxy (para métricas/limites).
model UsageLog {
  id           String   @id @default(cuid())
  proxyKeyId   String
  ts           DateTime @default(now())
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  estimated    Boolean  @default(true)
  latencyMs    Int      @default(0)
  status       Int      @default(200)
  proxyKey     ProxyKey @relation(fields: [proxyKeyId], references: [id], onDelete: Cascade)

  @@index([proxyKeyId, ts])
}

model AuditLog {
  id      String   @id @default(cuid())
  actorId String?
  action  String
  target  String?
  meta    Json?
  ts      DateTime @default(now())
  actor   User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ts])
}

enum CliKind {
  claude
  codex
  gemini
  cursor
  opencode
  antigravity
  // 2º lote — outras CLIs do mercado
  copilot
  aider
  qwen
  amp
  goose
  grok
  continue
}
